# Build directories
build/
build-*/
cmake-build-*/
out/

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json

# Binaries
*.o
*.a
*.so
*.so.*
*.dylib

# Packaged output. `cpack` writes into the source directory when the project
# installs with CPACK_INSTALL_CMAKE_PROJECTS set, which is how the .deb can be
# inspected afterwards.
*.deb
*.rpm
*.AppImage
*.tar.gz
*.dmg
*.zip
*.flatpak
*.appdata.xml
*.metainfo.xml.in
flatpak-build/
.flatpak-builder/
repo/
# cpack drops its staging tree next to the build directory when CPACK_INSTALL_CMAKE_PROJECTS
# is set, which it is here so the .deb can be inspected.
_CPack_Packages/
pkg/
src/*.pkg.tar.zst
*.pkg.tar.zst

# Editors and tools
.vscode/
.idea/
*.swp
*~
.cache/
compile_commands.json

# OS
.DS_Store
Thumbs.db