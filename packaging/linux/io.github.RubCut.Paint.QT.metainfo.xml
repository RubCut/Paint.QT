<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata. Flathub reads this, GNOME Software and KDE Discover read
  it, and the AppImage toolchain validates it. Without it a Flathub submission is
  rejected, so this file is part of the build inputs and is tested.
-->
<component type="desktop-application">
  <id>io.github.RubCut.Paint.QT</id>
  <launchable type="desktop-id">io.github.RubCut.Paint.QT.desktop</launchable>

  <name>Paint.QT</name>
  <summary>A raster image editor for Linux desktops, with the tool set and layout of Paint.NET</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <!-- Without an icon the component is invisible. appstreamcli compose filters
       it out, then reports file-read-error for a component it never read, and
       the Flatpak build fails at the end even though the application compiled
       and exported. The validator allows only the stock and remote types, and
       stock is the one for an icon installed in hicolor.

       The name matches the file that is installed, which is named after the
       application id: Flatpak exports only the files whose names match the id,
       and it refuses anything else with "non-allowed export filename". -->
  <icon type="stock">io.github.RubCut.Paint.QT.png</icon>

  <description>
    <p>
      Paint.QT is a raster image editor for photos, drawings and graphics work. It
      is modelled on Paint.NET: the same tools, the same palette layout, the same
      .pdn file format, and the same history where one stroke is one undo step.
    </p>
    <p>Among its tools:</p>
    <ul>
      <li>Pencil, paintbrush, eraser, colour picker and gradient</li>
      <li>Blur, smudge, dodge and burn, and recolour</li>
      <li>Shapes: line, rectangle, ellipse, polygon, freeform and curve</li>
      <li>Text, marquee and lasso selection, move, rotate, flip and scale</li>
    </ul>
    <p>It also has:</p>
    <ul>
      <li>Layers with opacity, locking, merging and flattening</li>
      <li>A full undo history where every stroke is a separate step</li>
      <li>The clipboard wired to the system clipboard, so images move between applications</li>
      <li>Reading and writing .pdn, so documents move between this editor and Paint.NET</li>
      <li>A light theme that follows the system, and a dark one</li>
    </ul>
  </description>

  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>RasterGraphics</category>
  </categories>

  <keywords>
    <keyword>paint</keyword>
    <keyword>image</keyword>
    <keyword>editor</keyword>
    <keyword>raster</keyword>
    <keyword>graphics</keyword>
    <keyword>draw</keyword>
    <keyword>photo</keyword>
  </keywords>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/RubCut/Paint.QT/bca52acd6da1ff730b40c34c7716c28c405083aa/packaging/linux/screenshots/01-window.png</image>
      <caption>The window as it opens, with the palettes floating over it</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/RubCut/Paint.QT/bca52acd6da1ff730b40c34c7716c28c405083aa/packaging/linux/screenshots/02-drawing.png</image>
      <caption>Freehand strokes, each one a separate step in the history</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/RubCut/Paint.QT/bca52acd6da1ff730b40c34c7716c28c405083aa/packaging/linux/screenshots/03-layers.png</image>
      <caption>A second layer with a shape on it</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.1" date="2026-10-02">
      <description>
        <p>The metadata is now correct: the metainfo names an icon, without which
        appstreamcli cannot compose the component, the application id matches the
        repository it lives in, and the packages carry the real homepage and
        contact. The licence is installed where Debian, Arch and RPM each look
        for it.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-10-01">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>

  <url type="homepage">https://github.com/RubCut/Paint.QT</url>
  <url type="bugtracker">https://github.com/RubCut/Paint.QT/issues</url>
  <url type="vcs-browser">https://github.com/RubCut/Paint.QT</url>

  <developer id="io.github.rubcut">
    <name>RubCut</name>
  </developer>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

</component>