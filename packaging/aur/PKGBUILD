# Maintainer: Paint.QT contributors <boldbalabol@gmail.com>
#
# Builds from the release tarball of the matching tag. To package an unreleased
# commit instead, replace the source and checksums with:
#
#   source=('git+https://github.com/RubCut/Paint.QT.git')
#   sha256sums=('SKIP')   # makepkg takes the revision from the checkout
#
# and makepkg will take pkgver() from the tag it checks out.

pkgname=paint-qt
pkgver=1.0.2
pkgrel=1
pkgdesc="A raster image editor for Linux desktops, with the tool set of Paint.NET"
arch=('x86_64' 'aarch64')
url="https://github.com/RubCut/Paint.QT"
license=('GPL3')
depends=('qt6-base' 'qt6-svg')
makedepends=('cmake' 'ninja')
optdepends=('dark-theme: follow the system colour scheme, or pick a theme from the View menu')
# GitHub's tag archive. The first field renames the download; the second is where
# it comes from. Its checksum is of that archive and has to be replaced on every
# release, which is what `updpkgsums` does.
source=("$pkgname-$pkgver.tar.gz::https://github.com/RubCut/Paint.QT/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2297d9ddd7660be24cb077fe148ab35f417baae7dee41ea1463375c3b04e422d')

# makepkg runs every step with the working directory set to the package
# directory, which is where the build tree has to live. The source tree is
# addressed by absolute path instead, because `cd`-ing into it makes the
# relative `build` path below point at a directory that does not exist there.
# GitHub names the directory inside the archive after the repository, not after
# the package: the archive of tag v1.0.0 unpacks to Paint.QT-1.0.0. Using
# $pkgname-$pkgver here pointed at a directory that does not exist, so the build
# never started.
_srcdir="$(pwd)/src/Paint.QT-$pkgver"
_builddir="$(pwd)/build"

build() {
    cmake -S "$_srcdir" -B "$_builddir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DQT_VERSION=6 \
        -Wno-dev
    cmake --build "$_builddir"
}

# The whole suite runs headless, so it needs no display.
check() {
    QT_QPA_PLATFORM=offscreen ctest --test-dir "$_builddir" --output-on-failure
}

package() {
    # --prefix here as well as at configure time: without it CMake reuses the
    # prefix the build tree was configured with, and the files land in
    # /usr/local, which is wrong on Arch.
    DESTDIR="$pkgdir" cmake --install "$_builddir" --prefix /usr

    # CPack is not what makepkg runs, so the desktop entry, the AppStream
    # metadata and the licence are placed by hand.
    # Named after the application id rather than the binary: Flatpak exports only
    # the files whose names match the id, and Flathub requires the same.
    install -Dm644 "$_srcdir/packaging/linux/paint-qt.desktop" \
        "$pkgdir/usr/share/applications/io.github.RubCut.Paint.QT.desktop"
    install -Dm644 "$_srcdir/packaging/linux/io.github.RubCut.Paint.QT.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.RubCut.Paint.QT.metainfo.xml"
    install -Dm644 "$_srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Arch does not ship debug info in a release package.
    strip --strip-unneeded "$pkgdir/usr/bin/paint-qt"
}