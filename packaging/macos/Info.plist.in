<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS bundle metadata. CMake substitutes the @VARIABLES@; the rest is filled in
  by the flatpak and Linux packages, which read their own metadata instead.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Paint.QT</string>
    <key>CFBundleDisplayName</key>
    <string>Paint.QT</string>
    <key>CFBundleExecutable</key>
    <string>paint-qt</string>
    <key>CFBundleIdentifier</key>
    <string>@PNQ_APP_ID@</string>
    <key>CFBundleIconFile</key>
    <string>paint-qt.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>Paint.NET is a registered trademark of its owner. This is an independent reimplementation.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Qt draws the whole window itself, so the app is a single window with
         no menu bar of its own. -->
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.graphics-design</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Paint.NET image</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.image</string>
            </array>
        </dict>
    </array>
</dict>
</plist>