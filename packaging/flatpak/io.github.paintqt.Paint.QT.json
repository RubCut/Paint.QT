id: io.github.paintqt.Paint.QT
runtime: org.kde.Platform
runtime-version: '6.7'
sdk: org.kde.Sdk
base: app

command: paint-qt

finish-args:
  # The palettes float inside the window, so no X11 or Wayland socket is needed
  # and nothing is granted beyond the default sandbox. Files the user picks are
  # reached through the GTK file dialog portal.
  - --share=ipc
  - --socket=fallback-x11
  - --socket=wayland
  - --device=dri
  - --filesystem=xdg-pictures
  - --filesystem=xdg-documents
  - --filesystem=xdg-download

build-options:
  append-path: /usr/lib/sdk/qt6/bin
  prepend-ld-library-path: /usr/lib/sdk/qt6/lib
  env:
    # Qt refuses to create a GL context on llvmpipe; software rendering is what
    # the sandbox has, so say so instead of letting it guess.
    QT_LOGGING_RULES: 'qt.qpa.xcb.warning=false'
    CMAKE_BUILD_PARALLEL_LEVEL: '4'

modules:
  - name: paint-qt
    buildsystem: simple
    build-commands:
      - cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DQT_VERSION=6
      - cmake --build build
      # The icons come from the SVG, rendered by the same rasteriser the icon
      # test compares against.
      - cmake --build build --target pnq_icons_generated
      - DESTDIR=/app cmake --install build
    sources:
      - type: dir
        path: ..
    cleanup:
      - /include
      - /lib/*.a
      - /lib/pkgconfig
      - /share/doc
      - /share/man
      - '*.a'
      - '*.la'