// Windows resources.
//
// The icon lives in the executable itself, so Explorer, the taskbar, the Alt+Tab
// switcher and the "Change icon" dialog all show the application mark without
// anybody having to install a file first. windres compiles this against the
// .ico that tools/make_icons.cpp generates.

#define IDI_APP_ICON 1

IDI_APP_ICON ICON "paint-qt.ico"

// Qt asks the application for its icon at runtime, which on Windows also means
// the default icon of a console window attached to the process. Only the GUI
// subsystem build has a window, but setting the module icon is harmless there
// and keeps the resource table complete.
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Paint.QT contributors"
            VALUE "FileDescription",  "Paint.QT - raster image editor"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "paint-qt"
            VALUE "OriginalFilename", "paint-qt.exe"
            VALUE "ProductName",      "Paint.QT"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END